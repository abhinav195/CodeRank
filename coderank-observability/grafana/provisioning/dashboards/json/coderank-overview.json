  "panels": [
    {
      "id": 1,
      "title": "coderank-auth \u2014 JVM Heap Used",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"coderank-auth\",area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "coderank-auth \u2014 HTTP Request Rate",
