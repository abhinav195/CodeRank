      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"coderank-auth\"}[1m]))",
          "legendFormat": "req/sec",
          "refId": "A"
